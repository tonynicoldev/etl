# Virtually nothing in here - but there could be

DB_TYPE=MYSQL
MYSQL_MAX_CONNECTION_RETRIES=3 # Could be more if using a container on a low powered vm

# In prod (Compose env file) define but just don't give these a value so they will be set at the default
MONGO_SVR_SELECT_TIMEOUT=2000 # just dev. How long it waits to find the server. 30s is default, I'm not waiting 30s
MONGO_CONN_TIMEOUT=2000; # Just dev. Wait time for a tcp connection. 30s is default - set here to 2s