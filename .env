# NOTE: Use env var in etl.je default when using vscode as it doesn't read this file until containerisation

# Either change the value of DB_TYPE to reflect which container is created and which database file will be used by the app server
# or override it using a commandline env var which takes precedence within the compose file regardless of what is set in here
# don't use it and provide the DB_TYPE at the command line. Also, putting mongo different .yaml file to override if needed

DB_TYPE=MYSQL # use MONGO for mongodb


# ETL CONFIG
APP_PORT=1000
ETL_CONTAINER_PORT=4000 # Map container to app in compose. Leave out in prod
ETL_CONT_SERVICE=etl    # Service name used for DNS for internal api calls

# MYSQL CONFIG
MYSQL_USER=admin     
MYSQL_PASSWORD=admin
MYSQL_ROOT_PASSWORD=admin 
MYSQL_DATABASE=triv
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_CONTAINER_PORT=4001 # Map container to app in compose
MYSQL_MAX_CONNECTION_RETRIES=10 # Number of tries to connect to a database 

# MONGO CONFIG
MONGO_DATABASE=triv
MONGO_HOST=db     # Container service name
MONGO_PORT=27017
MONGO_CONTAINER_PORT=4002 # Map container to app in compose


# FIlenames of database code and data files
MYSQL_MODULE=./database/mysql-database-fns
MONGO_MODULE=./database/mongo-database-fns

STAGING_AREA=./.data/  # Quiz text files



